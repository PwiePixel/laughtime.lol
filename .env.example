# ---------------------------------------------------------------
# LaughTime.lol configuration
# Pterodactyl variables with the same name override these values.
# ---------------------------------------------------------------

# Port: Pterodactyl sets SERVER_PORT automatically, PORT is the fallback
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://laughtime.lol

# Set to true when running behind Nginx / Cloudflare so the real visitor IP is used for rate limits
TRUST_PROXY=true

# --- Media sources (everything is pulled automatically, nothing to upload) ---
# Imgflip (images + GIF templates as MP4) works without a key and is always on.
IMGFLIP_ENABLED=true
# how many Imgflip template pages to read (40 templates per page)
IMGFLIP_PAGES=6

# GIPHY – free key: https://developers.giphy.com/dashboard/
GIPHY_API_KEY=

# KLIPY – free key (replacement for the Tenor API, which Google shut down in 2026): https://partner.klipy.com/api-keys
# Test keys allow 100 calls per hour (LaughTime needs about 12) – request a production key before launch.
# Delivers short movie/TV clips and reaction GIFs.
KLIPY_API_KEY=
# which KLIPY content to use: clips, gifs or both
KLIPY_TYPES=clips,gifs
KLIPY_LOCALE=en_US
KLIPY_CUSTOMER_ID=laughtime-server

# Reddit – works without a key, but Reddit blocks many server IPs.
# Create a "script" app at https://www.reddit.com/prefs/apps and add the id/secret for reliable access.
# "redirect uri" is not used by LaughTime (app-only login) – just enter http://localhost:8080
# Tip: put your Reddit name into the user agent, e.g. web:laughtime.lol:v1.0.0 (by /u/yourname)
REDDIT_ENABLED=true
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:laughtime.lol:v1.0.0 (meme party game)
REDDIT_VIDEO_SUBS=MemeVideos,dankvideos,Funnymemes
REDDIT_IMAGE_SUBS=MemeTemplatesOfficial,memetemplates

# Search words used for GIPHY / KLIPY clips (comma separated)
SEARCH_TERMS=reaction,fail,shocked,awkward,dance,cat,dog,facepalm,confused,laughing,cringe,celebrate,nope,surprised,eye roll,waiting,panic,sad,thumbs up,mind blown

# Content rating for GIPHY/KLIPY: g, pg, pg-13 or r
CONTENT_RATING=pg-13
# Max length of short videos in seconds
MAX_VIDEO_SECONDS=30
# Words that remove a template when they appear in its title (comma separated)
BLOCKED_WORDS=nsfw,nude,porn,hitler,nazi,9/11,isis,rape

# --- Media cache (videos/images are proxied and cached on disk) ---
CACHE_MAX_MB=800

# --- Accounts ---
# Discord login (optional): create an app at https://discord.com/developers/applications
# OAuth2 -> Redirects: https://laughtime.lol/api/auth/discord/callback  (PUBLIC_URL + /api/auth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Usernames with admin rights (admin area at /admin: dashboard, reports, bans, pack review), comma separated
ADMIN_USERNAMES=
# Discord Activity (LaughTime inside Discord voice calls) – uses the same Discord app as the login.
# Developer Portal: Activities -> URL Mappings "/" -> laughtime.lol, Activities -> Settings -> Enable Activities
ACTIVITY_ENABLED=true
# optional: bot token of the same app – verifies activity sessions with Discord's API
DISCORD_BOT_TOKEN=
# Secret key for hashing IP addresses (bans/reports). Leave empty to auto-create data/.moderation-salt
# (back that file up – if it changes, existing IP bans stop matching).
MODERATION_SALT=
# Force the "Secure" flag on cookies (normally detected automatically behind HTTPS proxies)
COOKIE_SECURE=false

# --- Game ---
MAX_ROOMS=300
# minimum players to start a game (set to 1 for testing alone)
MIN_PLAYERS=2

# --- Quick play (public matchmaking) ---
# a countdown starts at MATCH_MIN_PLAYERS, the match starts at once with MATCH_MAX_PLAYERS
MATCH_MIN_PLAYERS=4
MATCH_MAX_PLAYERS=8
# seconds to wait for more players once the minimum is reached
MATCH_WAIT_SECONDS=8
# after waiting this long with too few players, MATCH_RELAX_PLAYERS is enough (0 = never)
MATCH_RELAX_SECONDS=60
MATCH_RELAX_PLAYERS=2

# --- Own uploads (Meme Studio + swap rounds) ---
# max. file size in MB (PNG, JPG, GIF, WebP)
UPLOAD_MAX_MB=8
# max. number of uploads per account (Meme Studio)
UPLOADS_PER_USER=200

# --- GIF Hunt mode ---
# searches per player per round
HUNT_SEARCHES=2


# ---------------------------------------------------------------
# LaughTime v2 – new, optional settings
# Everything below has a built-in default: an older .env without
# these lines keeps working unchanged.
# ---------------------------------------------------------------

# --- Main page + beta on ONE instance ---
# The beta is the same app: visitors opt in on /beta, or open a beta host.
BETA_ENABLED=true
# hosts that always show the beta, comma separated (empty = "beta." + host of PUBLIC_URL)
BETA_HOSTS=
# who may join the beta: open, accounts (logged in) or admins (ADMIN_USERNAMES)
BETA_ACCESS=open
# optional link for feedback on the beta page (e.g. your Discord server)
BETA_FEEDBACK_URL=
# promote or switch off single features without a code change, e.g. status-card=stable,foo=off
FEATURE_FLAGS=

# --- API protection (rate limits of the media sources) ---
# max. requests per hour to each API (0 = no limit) – raise them with production keys
GIPHY_HOURLY_LIMIT=90
KLIPY_HOURLY_LIMIT=90
IMGFLIP_HOURLY_LIMIT=600
# search results (GIF Hunt, swap round, studio) are kept in memory this long
SEARCH_CACHE_MINUTES=15
SEARCH_CACHE_ENTRIES=500

# --- Image pipeline ---
# scaled AVIF/WebP variants in the media proxy (false = always the original file)
IMAGE_VARIANTS=true
# AVIF for small pictures (false = WebP only, saves CPU on weak servers)
IMAGE_AVIF=true
# picture conversions running at the same time (1-8)
IMAGE_WORKERS=2
# compress WebSocket messages – only worth it when traffic is expensive
WS_COMPRESSION=false

# --- Discord webhooks (optional, empty = off) ---
# community announcements (install.sh posts "LaughTime v2 is live" here; also: node scripts/announce.mjs "Title" "Text")
DISCORD_WEBHOOK_URL=
# heads-up for the moderators on new reports / pack reviews (at most one message per minute, no personal data)
DISCORD_MOD_WEBHOOK_URL=
# language of the moderator heads-up: en or de
DISCORD_WEBHOOK_LANG=en
